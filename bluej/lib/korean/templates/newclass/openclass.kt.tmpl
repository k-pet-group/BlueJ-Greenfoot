$PKGLINE/**
 * $CLASSNAME 클래스의 설명을 작성하세요.
 *
 * @author (작성자 이름)
 * @version (버전 번호 또는 작성한 날짜)
 */
open class $CLASSNAME {
    // 인스턴스 변수 - 다음의 예제를 사용자에 맞게 변경하세요.
    var x: Int = 0

    /**
     * 예제 open 메소드 - 이 주석을 사용자에 맞게 바꾸십시오
     *
     * @param y     메소드의 샘플 파라미터
     * @return      x 더하기 y의 결과값을 반환
     */
    open fun sampleMethod(y: Int): Int {
        return x + y
    }
}
